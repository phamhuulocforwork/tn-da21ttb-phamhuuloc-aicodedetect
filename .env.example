BACKEND_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here
ENVIRONMENT=production
LOG_LEVEL=info

FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
NEXT_PUBLIC_ENABLE_CHARTS=true
NEXT_PUBLIC_MAX_CODE_LENGTH=50000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000

# Tên miền cho chứng chỉ SSL (để trống nếu truy cập bằng IP với SSL tự ký)
SSL_DOMAIN=
# Email để nhận thông báo từ Let's Encrypt (không cần nếu truy cập bằng IP)
SSL_EMAIL=
# Sử dụng môi trường staging của Let's Encrypt
SSL_STAGING=false

# Để truy cập bằng IP mà không có domain, hãy để SSL_DOMAIN trống
# Hệ thống sẽ dùng chứng chỉ SSL tự ký
# Truy cập qua: http://YOUR_IP:80 hoặc https://YOUR_IP:443
#
# KHÔNG DÙNG DOMAIN (truy cập qua IP):
# 1. Để trống SSL_DOMAIN
# 2. Truy cập qua: http://your_vps_ip:80
# 3. HTTPS sẽ dùng chứng chỉ tự ký
# 4. Trình duyệt sẽ cảnh báo bảo mật khi dùng HTTPS
#
# CÓ DOMAIN:
# 1. Đặt SSL_DOMAIN=yourdomain.com
# 2. Trỏ domain về IP của VPS
# 3. Truy cập qua: https://yourdomain.com
# 4. Chứng chỉ SSL sẽ được tự động tạo